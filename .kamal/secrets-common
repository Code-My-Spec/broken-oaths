# Kamal reads this as a Dotenv file — values like ${VAR} are interpolated
# from the environment of the kamal process. Populate the env first via
# scripts/deploy or scripts/deploy-uat, which source the AWS bootstrap
# creds from the devops repo's .env and the registry token from
# `gh auth token`.
#
# This is the SHORT list — Kamal carries only AWS bootstrap creds (so
# BrokenOaths.Secrets.load!/1 inside the container can fetch the rest
# from SSM at boot) plus the registry token for image pulls. App secrets
# are NEVER passed through here. See lib/broken_oaths/secrets.ex.

KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
