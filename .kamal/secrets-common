# Kamal reads this as a Dotenv file — values like ${VAR} are interpolated
# from the environment of the kamal process.
#
# This is the SHORT list — Kamal carries only the age key (so
# rel/overlays/bin/boot and bin/migrate inside the container can decrypt
# envs/<env>.enc.env at boot) plus the registry token for image pulls.
# App secrets are NEVER passed through here directly — they travel as
# ciphertext baked into the image instead. Migrated off AWS SSM
# (BrokenOaths.Secrets.load!/1, removed); see config/runtime.exs.

KAMAL_REGISTRY_USERNAME=${KAMAL_REGISTRY_USERNAME}
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD}
SOPS_AGE_KEY=${SOPS_AGE_KEY}
